# Wikipedia User Credentials
WIKI_USERNAME=your_wikipedia_username
WIKI_PASSWORD=your_wikipedia_password

# Wikipedia Meta API OAuth Credentials
# Get these from https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration
WIKI_META_CLIENT_ID=your_client_id
WIKI_META_CLIENT_SECRET=your_client_secret

# ReportPortal Configuration (optional)
REPORTPORTAL_API_KEY=your_reportportal_api_key

# Environment Selection (dev/prod)
ENV=dev

# Demoblaze UI Configuration
DEMOBLAZE_BASE_URL=https://www.demoblaze.com
DEMOBLAZE_HOME_URL=https://www.demoblaze.com/index.html
DEMOBLAZE_CART_URL=https://www.demoblaze.com/cart.html
